{
  "name": "neon-coast",
  "version": "0.1.0",
  "description": "The pixel look of phareim.no as a design system: one CSS file for HTML, a canvas kit for games, two custom elements.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phareim/neon-coast.git"
  },
  "homepage": "https://github.com/phareim/neon-coast#readme",
  "keywords": ["design-system", "pixel-art", "css", "canvas", "synthwave", "retro"],
  "main": "./dist/neon-coast.js",
  "module": "./dist/neon-coast.js",
  "types": "./dist/types/index.d.ts",
  "style": "./dist/neon-coast.css",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/neon-coast.js"
    },
    "./css": "./dist/neon-coast.css",
    "./neon-coast.css": "./dist/neon-coast.css",
    "./tokens.json": "./dist/tokens.json",
    "./fonts/*": "./dist/fonts/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "*.css",
    "./dist/neon-coast.js",
    "./dist/neon-coast.min.js",
    "./src/js/index.js"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "font": "node scripts/make-font.mjs",
    "fonts": "node scripts/copy-fonts.mjs && node scripts/make-font.mjs",
    "typecheck": "tsc -p jsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "serve": "node scripts/serve.mjs",
    "design-system": "node scripts/export-design-system.mjs build/design-system"
  },
  "devDependencies": {
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
